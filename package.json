{
  "name": "onlysource",
  "version": "0.0.1",
  "private": true,
  "description": "ONLYSOURCE.ai. Operator workspace for defense parts dealers.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate:r0": "node scripts/lint-gates.mjs && node scripts/lint-gates.mjs --selftest && node scripts/secret-scan.mjs",
    "gate:r0:lints": "node scripts/lint-gates.mjs",
    "gate:r0:selftest": "node scripts/lint-gates.mjs --selftest",
    "gate:r0:secrets": "node scripts/secret-scan.mjs",
    "gate:r1": "vitest run test/r1-time",
    "gate:all": "npm run gate:r0 && npm run gate:reachability:selftest && npm run gate:reachability && npm run typecheck && npm run test",
    "ingest:capture": "npx tsx scripts/ingest/capture-day.mts",
    "ingest:backfill": "npx tsx scripts/ingest/backfill.mts",
    "ingest:series": "npx tsx scripts/ingest/capture-series.mts",
    "gate:corner-reachability": "node scripts/verify-corner-reachability.mjs",
    "gate:reachability:selftest": "node scripts/reachability-census.mjs --selftest",
    "gate:reachability": "node scripts/reachability-census.mjs",
    "gate:reachability:list": "node scripts/reachability-census.mjs --list",
    "sweep:selftest": "node scripts/route-body-sweep.mjs --selftest",
    "sweep:anon": "node scripts/route-body-sweep.mjs --anon",
    "sweep": "node scripts/route-body-sweep.mjs",
    "gate:data:selftest": "node scripts/data-reachability.mjs --selftest",
    "gate:data": "node scripts/data-reachability.mjs",
    "gate:data:require": "node scripts/data-reachability.mjs --require series,archive,flis"
  },
  "dependencies": {
    "@sentry/nextjs": "10.70.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "better-auth": "^1.6.27",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "embedded-postgres": "^17.5.0-beta.15",
    "playwright": "^1.56.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
