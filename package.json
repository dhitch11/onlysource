{
  "name": "onlysource",
  "version": "0.0.1",
  "private": true,
  "description": "ONLYSOURCE.ai. Operator workspace for defense parts dealers.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate:r0": "node scripts/lint-gates.mjs && node scripts/lint-gates.mjs --selftest && node scripts/secret-scan.mjs",
    "gate:r0:lints": "node scripts/lint-gates.mjs",
    "gate:r0:selftest": "node scripts/lint-gates.mjs --selftest",
    "gate:r0:secrets": "node scripts/secret-scan.mjs",
    "gate:r1": "vitest run test/r1-time",
    "gate:all": "npm run gate:r0 && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@sentry/nextjs": "10.70.0",
    "better-auth": "^1.6.27",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "embedded-postgres": "^17.5.0-beta.15",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
