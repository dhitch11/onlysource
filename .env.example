# ONLYSOURCE.ai environment. Copy to .env.local for development.
# Secrets are by reference, never committed. If one lands in the repo, rotate it. Do not just
# delete the commit.

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. The app fails CLOSED without these, it never fails open.
# ---------------------------------------------------------------------------

# The day-one pre-release gate. Replaced by Better Auth and deleted, not kept as a backdoor.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PREVIEW_GATE_SECRET=

# The shared password the pre-release gate checks. Same generation command.
PREVIEW_GATE_PASSWORD=

# ---------------------------------------------------------------------------
# OPTIONAL. Absent means the feature reports itself as not connected. Nothing crashes,
# nothing hides, nothing lies.
# ---------------------------------------------------------------------------

# Sentry. Absent means /api/health reports sentry: not_configured.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Postgres (Neon, us-east-1). Two roles, never one.
#   DATABASE_URL_MIGRATOR  connects as app_migrator, owns the tables, runs migrations only.
#   DATABASE_URL_RUNTIME   connects as app_runtime, owns nothing, lacks BYPASSRLS, is what
#                          the application uses. Pooled endpoint, transaction mode.
# If the application ever connects as the owner, every RLS policy is decorative and every
# test still passes. That is the one defect this split exists to make impossible.
DATABASE_URL_MIGRATOR=
DATABASE_URL_RUNTIME=

# Credential canary values for the R0.2 scan, comma separated. Loaded from the vault at CI
# time and NEVER committed. Reproducing a known-compromised credential in a fixture is the
# same defect as leaking it.
CANARY_VALUES=
